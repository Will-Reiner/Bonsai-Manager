// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // rhel-openssl-3.0.x = runtime das funções da Vercel
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Neon: DATABASE_URL = conexão pooled (-pooler); DIRECT_URL = conexão direta (usada pelas migrations)
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- ENUMS ---
// Define os valores permitidos para campos específicos

enum Role {
  USER
  ADMIN
}

enum TipoNotificacao {
  CURTIDA
  COMENTARIO
  SEGUIU
}

enum AgendaStatus {
  PENDENTE
  CONCLUIDO
  CANCELADO
}

enum UnidadeMedida {
  UNIDADE
  KG
  G
  L
  ML
}

enum ModoAquisicao {
  SEMENTE
  ESTACA
  ALPORQUIA
  YAMADORI
  COMPRA
}

enum Estacao {
  PRIMAVERA
  VERAO
  OUTONO
  INVERNO
}

enum MomentoIdeal {
  DEVE_FAZER
  PODE_FAZER
  EVITAR
}

enum RecomendacaoTecnica {
  RECOMENDADA
  NAO_RECOMENDADA
  COM_CUIDADO
}

enum TipoPlanta {
  PERENE
  CADUCIFOLIA
  SEMI_CADUCA
  ARVORE
  ARBUSTO
  CONIFERA
}

enum StatusEspecie {
  VERIFICADO
  SUGERIDO
}

enum TipoMidia {
  FOTO
  VIDEO
  VISAO_FUTURA
}

/// Grupos fixos de fase da planta (um por planta, opcional).
enum GrupoPlanta {
  PRE_TRANSPLANTE
  RECEM_TRANSPLANTADA
  DEBILITADA
  EM_CRESCIMENTO
  REFINAMENTO
}

// --- TABELAS PRINCIPAIS ---

model Usuario {
  id                 String    @id @default(uuid())
  nome               String
  nomePublico        String?
  email              String    @unique
  senhaHash          String
  localidade         String?
  fotoPerfilUrl      String?
  bio                String?   @db.Text
  perfilPublico      Boolean   @default(false)
  /// Cuidados aparecem nos posts e na página pública da planta.
  historicoPublico   Boolean   @default(false)
  /// Posts novos entram no feed (só com perfil público).
  postarAutomatico   Boolean   @default(true)
  recursosHabilitado Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  role               Role      @default(USER)

  // Relacionamentos
  plantas            Planta[]
  recursos           Recurso[]
  fotos              Foto[]
  seguindo           Amizade[] @relation("Seguidor")
  seguidores         Amizade[] @relation("Seguido")
  especiesSugeridas  Especie[]
  preferencias       PreferenciaUsuario[]
  posts              Post[]
  curtidas           Curtida[]
  comentarios        Comentario[]
  salvos             Salvo[]
  notificacoes       Notificacao[] @relation("NotificacoesRecebidas")
  notificacoesFeitas Notificacao[] @relation("NotificacoesFeitas")
}

model Especie {
  id                 String   @id @default(uuid())
  nomeCientifico     String?  @unique
  nomeComum          String?
  familia            String?
  origem             String?
  tipoDePlanta       TipoPlanta?
  status             StatusEspecie @default(SUGERIDO)
  folhas             String?  @db.Text
  tronco             String?  @db.Text
  flores             String?  @db.Text
  frutos             String?  @db.Text
  raizes             String?  @db.Text
  luminosidade       String?  @db.Text
  rega               String?  @db.Text
  substratoIdeal     String?  @db.Text
  adubacao           String?  @db.Text
  clima              String?  @db.Text
  problemasComuns    String?  @db.Text
  pros               String?  @db.Text
  contras            String?  @db.Text
  linhasDeRaciocinio String?  @db.Text
  observacoes        String?  @db.Text

  criadoPorId        String?
  criadoPor          Usuario? @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)

  // Relacionamentos
  plantas          Planta[]
  guiasDeTecnicas  GuiaDeTecnicas[]
  guiasSazonais    GuiaSazonal[]
}

model Planta {
  id               String        @id @default(uuid())
  nome             String?
  /// ID numérico da planta, único por usuário (gerado se não informado).
  identificador    Int
  dataAquisicao    DateTime?
  modoAquisicao    ModoAquisicao?
  observacoes      String?       @db.Text
  fotoCapaUrl      String?
  plantaPublica    Boolean       @default(false)
  historicoPublico Boolean       @default(false)
  grupo            GrupoPlanta?
  /// Grupo de retorno quando o período em RECEM_TRANSPLANTADA acabar.
  grupoAnterior    GrupoPlanta?
  /// Fim do período automático em RECEM_TRANSPLANTADA.
  grupoExpiraEm    DateTime?
  /// Agendamento de Transplante que já colocou a planta no Pré-transplante (impede reentrada pelo mesmo).
  preTransplanteAgendaId String?
  /// Transplante concluído que colocou a planta em RECEM_TRANSPLANTADA (para desfazer se ele mudar ou sumir).
  transplanteAgendaId    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  usuarioId        String
  usuario          Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  especieId        String?
  especie          Especie?      @relation(fields: [especieId], references: [id])

  // Relacionamentos
  fotos       Foto[]
  agendas     Agenda[]
  inspiracoes Inspiracao[]
  rotinas     Rotina[]
  posts       Post[]

  @@unique([usuarioId, identificador])
}

model Atividade {
  id                      String   @id @default(uuid())
  nome                    String   @unique
  descricao               String?  @db.Text
  objetivos               String?  @db.Text
  preparacao              String?  @db.Text
  execucao                String?  @db.Text
  cuidadosPosProcedimento String?  @db.Text
  createdAt               DateTime @default(now())

  // Relacionamentos
  agendas                Agenda[]
  rotinas                Rotina[]
  guiasDeTecnicas        GuiaDeTecnicas[]
  guiasSazonais          GuiaSazonal[]
  recursosSugeridos      AtividadeRecursoSugerido[]
  ferramentasSugeridas   AtividadeFerramentaSugerida[]
}

model Foto {
  id             String     @id @default(uuid())
  caminhoArquivo String
  titulo         String?
  tags           String?
  createdAt      DateTime   @default(now())
  dataCaptura    DateTime?  // data em que a mídia foi capturada (foto/vídeo)

  plantaId       String?
  planta         Planta?    @relation(fields: [plantaId], references: [id], onDelete: Cascade)

  usuarioId      String
  usuario        Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  agendaId       String?
  agenda         Agenda?    @relation(fields: [agendaId], references: [id], onDelete: SetNull)

  // Campos de mídia
  tipo           TipoMidia  @default(FOTO)
  descricao      String?    @db.Text
  thumbnailUrl   String?    // apenas para vídeos: URL R2 da thumbnail WebP

  // Relacionamentos
  inspiracoes Inspiracao[]
}

/// Uma planta num dia com foto (Comunidade). Conteúdo lido na hora de Foto/Agenda; nada copiado.
model Post {
  id          String   @id @default(uuid())
  /// Dia local (America/Sao_Paulo).
  dia         DateTime @db.Date
  /// Quando o post nasceu; ordena o feed.
  publicadoEm DateTime @default(now())
  /// true = só na página da planta/perfil, fora do feed.
  noFeed      Boolean
  createdAt   DateTime @default(now())

  usuarioId   String
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  plantaId    String
  planta      Planta   @relation(fields: [plantaId], references: [id], onDelete: Cascade)

  curtidas     Curtida[]
  comentarios  Comentario[]
  salvos       Salvo[]
  notificacoes Notificacao[]

  @@unique([plantaId, dia])
  @@index([noFeed, publicadoEm])
  @@index([usuarioId, publicadoEm])
}

model Curtida {
  createdAt DateTime @default(now())

  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([usuarioId, postId])
  @@index([postId])
}

model Comentario {
  id        String   @id @default(uuid())
  texto     String   @db.Text
  createdAt DateTime @default(now())

  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  notificacoes Notificacao[]

  @@index([postId, createdAt])
}

model Salvo {
  createdAt DateTime @default(now())

  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([usuarioId, postId])
  @@index([usuarioId, createdAt])
}

/// Aviso dentro do app (sem push). Apagar curtida/comentário/seguir remove o aviso correspondente.
model Notificacao {
  id           String          @id @default(uuid())
  tipo         TipoNotificacao
  lida         Boolean         @default(false)
  createdAt    DateTime        @default(now())

  /// Destinatário
  usuarioId    String
  usuario      Usuario         @relation("NotificacoesRecebidas", fields: [usuarioId], references: [id], onDelete: Cascade)

  atorId       String
  ator         Usuario         @relation("NotificacoesFeitas", fields: [atorId], references: [id], onDelete: Cascade)

  postId       String?
  post         Post?           @relation(fields: [postId], references: [id], onDelete: Cascade)

  comentarioId String?
  comentario   Comentario?     @relation(fields: [comentarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, lida, createdAt])
}

model Agenda {
  id               String       @id @default(uuid())
  dataAgendada     DateTime
  dataConcluida    DateTime?
  status           AgendaStatus @default(PENDENTE)
  detalhes         String?      @db.Text
  observacaoFutura String?      @db.Text
  /// Cancelada por "pular esta vez" (rotina) — distingue de cancelamento comum.
  pulada           Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  plantaId         String
  planta           Planta       @relation(fields: [plantaId], references: [id], onDelete: Cascade)

  atividadeId      String
  atividade        Atividade    @relation(fields: [atividadeId], references: [id])

  rotinaId         String?
  rotina           Rotina?      @relation(fields: [rotinaId], references: [id], onDelete: SetNull)

  // Relacionamentos
  recursosUtilizados AgendaRecursoUtilizado[]
  fotos              Foto[]
}

/// Tarefa recorrente rolante: a próxima nasce de "quando foi feito + intervalo". Uma por planta+atividade.
model Rotina {
  id            String    @id @default(uuid())
  intervaloDias Int
  estacoes      Estacao[] @default([]) // vazio = ano todo (regras na fase 3)
  pausada       Boolean   @default(false)
  dataFim       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  plantaId      String
  planta        Planta    @relation(fields: [plantaId], references: [id], onDelete: Cascade)
  atividadeId   String
  atividade     Atividade @relation(fields: [atividadeId], references: [id])

  agendas       Agenda[]

  @@unique([plantaId, atividadeId])
}

model Recurso {
  id                   String        @id @default(uuid())
  quantidadeDisponivel Int
  unidadeMedida        UnidadeMedida?
  observacoes          String?       @db.Text
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  usuarioId            String
  usuario              Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  
  tipoRecursoId        String
  tipoRecurso          TipoRecurso   @relation(fields: [tipoRecursoId], references: [id])

  // Relacionamentos
  agendasOndeFoiUtilizado AgendaRecursoUtilizado[]
}

model TipoRecurso {
  id   String @id @default(uuid())
  nome String @unique

  // Relacionamentos
  recursos                Recurso[]
  atividadesOndeESugerido AtividadeRecursoSugerido[]
}

model Ferramenta {
  id          String   @id @default(uuid())
  nome        String   @unique
  descricao   String?  @db.Text
  
  // Relacionamentos
  atividadesOndeESugerida AtividadeFerramentaSugerida[]
}

// --- TABELAS DE JUNÇÃO (Muitos-para-Muitos) ---

model Amizade {
  seguidorId String
  seguidoId  String
  createdAt  DateTime @default(now())
  
  seguidor   Usuario @relation("Seguidor", fields: [seguidorId], references: [id], onDelete: Cascade)
  seguido    Usuario @relation("Seguido", fields: [seguidoId], references: [id], onDelete: Cascade)

  @@id([seguidorId, seguidoId])
}

model GuiaDeTecnicas {
  especieId    String
  atividadeId  String
  recomendacao RecomendacaoTecnica
  observacoes  String?             @db.Text
  
  especie      Especie   @relation(fields: [especieId], references: [id], onDelete: Cascade)
  atividade    Atividade @relation(fields: [atividadeId], references: [id], onDelete: Cascade)

  @@id([especieId, atividadeId])
}

model GuiaSazonal {
  especieId    String
  atividadeId  String
  estacao      Estacao
  momentoIdeal MomentoIdeal
  observacoes  String?      @db.Text
  
  especie      Especie   @relation(fields: [especieId], references: [id], onDelete: Cascade)
  atividade    Atividade @relation(fields: [atividadeId], references: [id], onDelete: Cascade)

  @@id([especieId, atividadeId, estacao])
}

model Inspiracao {
  plantaId String
  fotoId   String
  
  planta   Planta @relation(fields: [plantaId], references: [id], onDelete: Cascade)
  foto     Foto   @relation(fields: [fotoId], references: [id], onDelete: Cascade)

  @@id([plantaId, fotoId])
}

model AgendaRecursoUtilizado {
  agendaId            String
  recursoId           String
  quantidadeUtilizada Float
  
  agenda              Agenda  @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  recurso             Recurso @relation(fields: [recursoId], references: [id], onDelete: Cascade)

  @@id([agendaId, recursoId])
}

model AtividadeRecursoSugerido {
  atividadeId   String
  tipoRecursoId String
  
  atividade     Atividade   @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  tipoRecurso   TipoRecurso @relation(fields: [tipoRecursoId], references: [id], onDelete: Cascade)

  @@id([atividadeId, tipoRecursoId])
}

model AtividadeFerramentaSugerida {
  atividadeId  String
  ferramentaId String

  atividade    Atividade  @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  ferramenta   Ferramenta @relation(fields: [ferramentaId], references: [id], onDelete: Cascade)

  @@id([atividadeId, ferramentaId])
}

model PreferenciaUsuario {
  id        String   @id @default(uuid())
  chave     String
  valor     String

  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([usuarioId, chave])
}
