# Database URLs for Prisma
# Local/Docker: as duas podem ser iguais.
# Neon (produção): DATABASE_URL = string "pooled" (host com -pooler) + "&pgbouncer=true&connection_limit=1"
#                  DIRECT_URL   = string direta (sem -pooler), usada por prisma migrate
DATABASE_URL="postgresql://user:password@localhost:5432/bonsai_db?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/bonsai_db?schema=public"

# JWT Secret
JWT_SECRET="CHANGE_THIS_IN_PRODUCTION_TO_A_VERY_LONG_RANDOM_STRING"

# Server Port
PORT=3000

# Origens permitidas no CORS (separadas por vírgula; "*.dominio" aceita subdomínios).
# Vazio = libera qualquer origem (apenas desenvolvimento).
CORS_ORIGIN="http://localhost:5173,*.pages.dev"

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your_bucket_name
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# E-mail promovido a ADMIN pelo seed (npm run seed)
ADMIN_EMAIL=
